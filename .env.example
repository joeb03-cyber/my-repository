# Local JSON is the default. Use "supabase" only for an isolated staging project.
BRAIN_DATA_SOURCE=local
BRAIN_SUPABASE_URL=
BRAIN_SUPABASE_ANON_KEY=

# Import-only server credentials. Never expose this key to the browser.
BRAIN_IMPORT_ENVIRONMENT=staging
BRAIN_IMPORT_PROJECT_REF=
BRAIN_IMPORT_ACKNOWLEDGE_NON_PRODUCTION=no
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
